font-family = "Hack Nerd Font Mono"
cursor-color = "#AAAAFF"
cursor-opacity = 0.9
cursor-text = "#FFFFFF"
cursor-style = "block"

keybind      = ctrl+==unbind
keybind      = ctrl+-=unbind

keybind      = shift+ctrl+==increase_font_size:1
keybind      = shift+ctrl+-=decrease_font_size:1

background-opacity = 0.87
background-opacity-cells = true

custom-shader = ./ghostty-cursor-shaders/ghostty/cursor_warp.glsl

config-file = ?./include/macos.toml
theme = noctalia
