#!/usr/bin/env python3
"""Preview a script Claude wrote, then run it on a y.

    claude-run [--apply] [project] script [-- args...]
    claude-run                          list every script

Scripts live in $XDG_DATA_HOME/scripts/<project>/, by default
~/.local/share/scripts. A name matches exactly first, then without its
extension, then by prefix, by substring, and by its letters in order. Several
matches give a menu. The script runs from its project folder on a y.

    --apply   skip the preview, and the [y/N] prompt for an exact match

A script can ask for two steps after it exits 0, one comment line each:

    # claude-run: copy ~/path/to/pr-body.txt   the file goes to the clipboard
    # claude-run: open https://github.com/...   the browser opens the URL
"""
import os
import platform
import re
import shutil
import subprocess
import sys

BASE = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "scripts")
AFTER = re.compile(r"^#\s*claude-run:\s*(copy|open)\s+(.+?)\s*$", re.MULTILINE)
TIERS = [
    lambda q, n: n == q,
    lambda q, n: os.path.splitext(n)[0].lower() == q.lower(),
    lambda q, n: n.lower().startswith(q.lower()),
    lambda q, n: q.lower() in n.lower(),
    lambda q, n: in_order(q.lower(), n.lower()),
]


def in_order(query, name):
    rest = iter(name)
    return all(c in rest for c in query)


def fail(message):
    sys.exit(f"claude-run: {message}")


def parse(argv):
    apply, words, extra = False, [], []
    for i, arg in enumerate(argv):
        if arg == "--":
            extra = argv[i + 1:]
            break
        if arg == "--apply":
            apply = True
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif arg.startswith("-"):
            fail(f"unknown flag {arg}. See claude-run --help")
        else:
            words.append(arg)
    if len(words) == 1 and "/" in words[0]:
        words = words[0].split("/", 1)
    if len(words) > 2:
        fail("too many names. Usage: claude-run [--apply] [project] script")
    return apply, words, extra


def listdir(path, want):
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if not n.startswith(".") and want(os.path.join(path, n))]


def projects():
    return listdir(BASE, os.path.isdir)


def scripts(project):
    return listdir(os.path.join(BASE, project), os.path.isfile)


def best(query, names):
    """The names in the first tier that matches, and whether that tier is exact."""
    for tier, test in enumerate(TIERS):
        hits = [n for n in names if test(query, n)]
        if hits:
            return hits, tier == 0
    return [], False


def find(words):
    """Every project/script the words match, and whether every word matched exactly."""
    if len(words) == 2:
        found, exact = best(words[0], projects())
    else:
        found, exact = projects(), True
    paths = [f"{p}/{s}" for p in found for s in scripts(p)]
    names = [p.split("/", 1)[1] for p in paths]
    hits, script_exact = best(words[-1], names)
    return [p for p in paths if p.split("/", 1)[1] in hits], exact and script_exact


def show_all():
    found = [f"{p}/{s}" for p in projects() for s in scripts(p)]
    if not found:
        print(f"No scripts yet in {BASE}")
    for path in found:
        print(path)


def open_tty():
    """The terminal as (input, output). Text mode "r+" fails on a tty, which cannot seek."""
    try:
        return open("/dev/tty"), open("/dev/tty", "w")
    except OSError:
        return None


def ask(tty, prompt):
    if tty is None:
        return ""
    tty[1].write(prompt)
    tty[1].flush()
    return tty[0].readline().strip()


def choose(tty, hits):
    if len(hits) == 1:
        return hits[0]
    lines = ["Found these scripts, which one?", "0) cancel"]
    lines += [f"{i}) {path}" for i, path in enumerate(hits, 1)]
    answer = ask(tty, "\n".join(lines) + "\n> ")
    if answer.isdigit() and 1 <= int(answer) <= len(hits):
        return hits[int(answer) - 1]
    sys.exit("cancelled")


def preview(path, name):
    with open(path, errors="replace") as f:
        text = f"==> {name} <==\n{f.read()}"
    rows = shutil.get_terminal_size().lines
    if sys.stdout.isatty() and text.count("\n") + 2 > rows and shutil.which("less"):
        # -X leaves the last page on screen above the prompt. -Ps sets less's
        # prompt, where a backslash keeps . ? : % literal.
        title = "".join("\\" + c if c in ".?:%\\" else c for c in name)
        subprocess.run(["less", "-X", f"-Ps{title} (q to quit, then answer y or N)"], input=text, text=True)
    else:
        print(text, end="" if text.endswith("\n") else "\n")


def afterwards(path):
    """The copy and open steps the script asks for, copies first so the clipboard is ready when the page loads."""
    with open(path, errors="replace") as f:
        steps = AFTER.findall(f.read())
    return sorted(steps, key=lambda step: step[0] != "copy")


def describe(steps):
    return "".join(f", then {verb} {os.path.basename(target) if verb == 'copy' else target}" for verb, target in steps)


def copy(target, folder):
    path = os.path.join(folder, os.path.expanduser(target))
    tools = [["pbcopy"]] if platform.system() == "Darwin" else [["wl-copy"], ["xclip", "-selection", "clipboard"]]
    tool = next((t for t in tools if shutil.which(t[0])), None)
    if not tool:
        fail("no clipboard tool: pbcopy, wl-copy or xclip")
    try:
        with open(path) as f:
            subprocess.run(tool, stdin=f, check=True)
    except OSError as error:
        fail(f"cannot copy {path}: {error.strerror}")
    print(f"claude-run: copied {target}")


def browse(url):
    subprocess.run(["open" if platform.system() == "Darwin" else "xdg-open", url], check=True)
    print(f"claude-run: opened {url}")


def run(path, extra, steps):
    if not os.access(path, os.X_OK):
        fail(f"it is not executable. Fix: chmod +x {path}")
    folder = os.path.dirname(path)
    code = subprocess.run([path, *extra], cwd=folder).returncode
    if code:
        if steps:
            print(f"claude-run: exit {code}, so no copy or open", file=sys.stderr)
        sys.exit(code)
    for verb, target in steps:
        if verb == "copy":
            copy(target, folder)
        else:
            browse(target)


def main():
    apply, words, extra = parse(sys.argv[1:])
    if not words:
        show_all()
        return
    hits, exact = find(words)
    if not hits:
        fail(f"no script matches {' '.join(words)}. Run claude-run to list them")
    tty = open_tty()
    name = choose(tty, hits)
    path = os.path.join(BASE, name)
    steps = afterwards(path)
    if not apply:
        preview(path, name)
    # --apply still asks when the name was not exact, so a typo cannot run the wrong script.
    if (not apply or not exact) and ask(tty, f"Run {name}{describe(steps)}? [y/N] ").lower() not in ("y", "yes"):
        sys.exit("not run")
    run(path, extra, steps)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\ncancelled")
